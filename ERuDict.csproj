<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ERuDict</RootNamespace>
    <AssemblyName>ERuDict</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <HybridGlobalization>true</HybridGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationTitle>ERuDict</ApplicationTitle>
    <Product>ERuDict</Product>
    <Description>English–Russian translator for selected text</Description>
    <Version>1.2.0</Version>
    <Authors>ERuDict</Authors>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="assets\app.ico" />
    <Content Include="dict\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
